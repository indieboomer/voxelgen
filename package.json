{
  "name": "voxel-generator-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsx scripts/verify.ts",
    "experiment": "tsx scripts/experiment.ts",
    "package:runtime": "tsc -p tsconfig.runtime.json && node scripts/runtime-package.mjs",
    "check:rust": "tsx scripts/rust-check.ts",
    "check:browser": "tsx scripts/workshop-v3-check.ts",
    "check:shape": "tsx scripts/shape-check.ts",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs && node scripts/activate-desktop.mjs",
    "check:workflow": "tsx scripts/workflow-check.ts && tsx scripts/prompt-target-check.ts && node scripts/image-adapter-check.mjs",
    "check:desktop": "node scripts/desktop-check.mjs",
    "check:meshing": "tsx scripts/greedy-check.ts",
    "check:meshing:browser": "tsx scripts/mesh-browser-check.ts",
    "check:smoothing": "tsx scripts/smoothing-check.ts",
    "check:smoothing:browser": "tsx scripts/smoothing-browser-check.ts",
    "check:smoothing:desktop": "tsx scripts/smoothing-desktop-check.ts",
    "check:vegetation": "tsx scripts/vegetation-check.ts",
    "check:vegetation:browser": "tsx scripts/vegetation-browser-check.ts",
    "check:vegetation:desktop": "tsx scripts/vegetation-desktop-check.ts",
    "check:reconstruction": "tsx scripts/reconstruction-check.ts",
    "check:reconstruction:browser": "tsx scripts/reconstruction-browser-check.ts",
    "check:reconstruction:desktop": "tsx scripts/reconstruction-desktop-check.ts",
    "check:references": "tsx scripts/references-check.ts",
    "check:references:browser": "tsx scripts/references-browser-check.ts",
    "check:references:desktop": "tsx scripts/references-desktop-check.ts",
    "check:six-views": "tsx scripts/six-views-check.ts",
    "check:six-views:browser": "tsx scripts/six-views-browser-check.ts",
    "check:six-views:desktop": "tsx scripts/six-views-desktop-check.ts",
    "check:source-textures": "tsx scripts/source-textures-check.ts",
    "check:source-textures:browser": "tsx scripts/source-textures-browser-check.ts",
    "check:source-textures:desktop": "tsx scripts/source-textures-desktop-check.ts",
    "check:hard-surface": "tsx scripts/hard-surface-check.ts",
    "check:hard-surface:browser": "tsx scripts/hard-surface-browser-check.ts",
    "check:hard-surface:desktop": "tsx scripts/hard-surface-desktop-check.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "electron": "^45.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "main": "desktop/main.cjs"
}
